
<h1>Cliente</h1>


<form action="/cliente/cadastrar" method="post" novalidate>
    <fieldset>
        <legend>Dados do cliente</legend>

        <div class="row g-3">
            <div class="col-md-6">
                <label for="nome" class="form-label">Nome <span aria-hidden="true">*</span></label>
                <input id="nome" name="nome" class="form-control" type="text" placeholder="Digite o nome" required maxlength="100" autofocus />
            </div>

            <div class="col-md-6">
                <label for="sobrenome" class="form-label">Sobrenome <span aria-hidden="true">*</span></label>
                <input id="sobrenome" name="sobrenome" class="form-control" type="text" placeholder="Digite o sobrenome" required maxlength="100" />
            </div>

            <div class="col-md-6">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="email" class="form-control" type="email" placeholder="exemplo@dominio.com" maxlength="200" />
            </div>

            <div class="col-md-6">
                <label for="telefone" class="form-label">Telefone</label>
                <input id="telefone" name="telefone" class="form-control" type="tel" placeholder="(XX) XXXXX-XXXX" pattern="[0-9()\-\s]+" maxlength="30" />
            </div>

            <div class="col-md-4">
                <label for="nascimento" class="form-label">Data de nascimento</label>
                <input id="nascimento" name="nascimento" class="form-control" type="date" />
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Enviar</button>
            <button type="reset" class="btn btn-secondary ms-2">Limpar</button>
        </div>
    </fieldset>
</form>
