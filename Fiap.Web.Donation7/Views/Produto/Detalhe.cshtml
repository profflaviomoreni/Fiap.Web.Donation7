@model ProdutoModel

<h1>Detalhe do Produto</h1>

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="well">
                    <div class="form-group">
                        <label class="control-label" for="NomeProduto">Nome Produto:</label>
                        <label class="control-label">@Model.NomeProduto</label>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Sugestão:</label>
                        <label class="control-label" name="SugestaoTroca">@Model.SugestaoTroca</label>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="CategoriaId">CategoriaId</label>
                        <label >@Model.CategoriaId</label>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="Disponivel">Disponivel</label>
                        <input type="checkbox" data-val="true" data-val-required="The Disponivel field is required." id="Disponivel" name="Disponivel" value="true" @(Model.Disponivel ? "checked" : "") />
                        <span class="text-danger field-validation-valid" data-valmsg-for="Disponivel" data-valmsg-replace="true"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="DataExpiracao">DataExpiracao</label>
                        <label class="form-control" type="datetime" id="DataExpiracao" name="DataExpiracao" value="">@Model.DataExpiracao</label>
                    </div>
                    <div class="form-group">
                        <input type="" value="Voltar" class="btn btn-primary" />
                    </div>

            </div>
        </div>
    </div>
</div>