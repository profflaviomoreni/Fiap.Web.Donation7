@model ProdutoModel

<h1>Detalhes do Produto</h1>

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="well">

                <dl class="row">
                    <dt class="col-sm-3"><label asp-for="NomeProduto" class="col-form-label"></label></dt>
                    <dd class="col-sm-9">@Model.NomeProduto</dd>

                    <dt class="col-sm-3"><label asp-for="Descricao" class="col-form-label"></label></dt>
                    <dd class="col-sm-9">@Model.Descricao</dd>

                    <dt class="col-sm-3"><label asp-for="SugestaoTroca" class="col-form-label"></label></dt>
                    <dd class="col-sm-9">@Model.SugestaoTroca</dd>

                    <dt class="col-sm-3"><label asp-for="Disponivel" class="col-form-label"></label></dt>
                    <dd class="col-sm-9">@(Model.Disponivel ? "Sim" : "Não")</dd>

                    <dt class="col-sm-3"><label asp-for="Valor" class="col-form-label"></label></dt>
                    <dd class="col-sm-9">@(Model.Valor.HasValue ? Model.Valor.Value.ToString("C") : "-")</dd>

                    <dt class="col-sm-3"><label asp-for="DataExpiracao" class="col-form-label"></label></dt>
                    <dd class="col-sm-9">@(Model.DataExpiracao.HasValue ? Model.DataExpiracao.Value.ToString("d") : "-")</dd>

                    <dt class="col-sm-3"><label asp-for="CategoriaId" class="col-form-label"></label></dt>
                    <dd class="col-sm-9">@(Model.Categoria?.NomeCategoria ?? Model.CategoriaId?.ToString() ?? "-")</dd>

                    <dt class="col-sm-3"><label asp-for="UsuarioId" class="col-form-label"></label></dt>
                    <dd class="col-sm-9">@(Model.Usuario?.Nome ?? Model.UsuarioId?.ToString() ?? "-")</dd>
                </dl>

                <a asp-controller="Produto" asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </div>
    </div>
</div>
