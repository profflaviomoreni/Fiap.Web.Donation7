@model ProdutoModel

<h1>Editar Produto</h1>

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="well">

                @if( ! string.IsNullOrEmpty(ViewBag.ErrorMessage) ) {
                    <div class="alert alert-warning">@ViewBag.ErrorMessage</div>
                }

                <form method="post" action="/produto/edit">
                    <input type="hidden" data-val="true" data-val-required="The ProdutoId field is required." id="ProdutoId" name="ProdutoId" value="0" />
                    <div class="form-group">
                        <label class="control-label" for="NomeProduto">NomeProduto</label>
                        <input class="form-control" type="text" data-val="true" data-val-required="The NomeProduto field is required." id="NomeProduto" name="NomeProduto" value="@Model.NomeProduto" />
                        <span class="text-danger field-validation-valid" data-valmsg-for="NomeProduto" data-valmsg-replace="true"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Sugestão</label>
                        <input type="text" name="SugestaoTroca" class="form-control" value="@Model.SugestaoTroca"/>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="CategoriaId">CategoriaId</label>
                        <input class="form-control" type="number" data-val="true" data-val-required="The CategoriaId field is required." id="CategoriaId" name="CategoriaId" value="@Model.CategoriaId" />
                        <span class="text-danger field-validation-valid" data-valmsg-for="CategoriaId" data-valmsg-replace="true"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="Disponivel">Disponivel</label>
                        <input type="checkbox" data-val="true" data-val-required="The Disponivel field is required." id="Disponivel" name="Disponivel" value="true" @(Model.Disponivel ? "checked" : "") />
                        <span class="text-danger field-validation-valid" data-valmsg-for="Disponivel" data-valmsg-replace="true"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="DataExpiracao">DataExpiracao</label>
                        <input class="form-control" type="datetime" id="DataExpiracao" name="DataExpiracao" value="@Model.DataExpiracao" />
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Salvar" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>