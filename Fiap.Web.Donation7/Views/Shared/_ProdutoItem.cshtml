@model ProdutoModel

<tr>
    <td data-field="id"> @Model.ProdutoId</td>
    <td data-field="name">@Model.NomeProduto</td>
    <td data-field="categoria">@Model.CategoriaId</td>
    <td data-field="disponivel">@Model.Disponivel</td>
    <td data-field="dataExpiracao">@Model.DataExpiracao</td>
    <td>
        <a asp-controller="Produto" asp-action="Detalhe" asp-route-id="@Model.ProdutoId">Detalhe</a>
        <a asp-controller="Produto" asp-action="Edit" asp-route-id="@Model.ProdutoId">Edit</a>
        <a asp-controller="Produto" asp-action="Delete" asp-route-id="@Model.ProdutoId">Delete</a>
    </td>
</tr>